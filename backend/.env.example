# StockRoom API — local development environment.
# In a deployed Colossus pod every value below is injected by the platform;
# this file exists so `npm run start:dev` works on a laptop.

# Postgres connection string used by Prisma (migrations, seed and runtime).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_development"

# Signing key for the 12-hour access tokens. Platform-provisioned in deployment.
JWT_SECRET="change-me-in-development-only"

# Port the API listens on. Matches backend.port in colossus.yaml.
PORT=3001

# Optional: pin the CORS origin. Unset means "reflect the request origin",
# which is what the single-origin nginx deployment relies on.
# FRONTEND_URL="http://localhost:4200"

# Platform-owned logins, consumed by prisma/seed/seed.js. Injected at provision.
# COLOSSUS_ACCOUNTS_JSON='[{"role":"ADMIN","email":"...","password":"...","login_path":"/login"}]'

# Managed service credentials surfaced in /api/admin/settings. Each is optional:
# a missing key degrades that one feature, it never prevents the API booting.
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=
