generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  /// bcryptjs hash (BCRYPT_ROUNDS in prisma/seed/seed.js and the auth service). Never store plaintext.
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movements Movement[]
}

/// One value per role the stack contract declares (stacks/combos/enterprise.json auth.roles).
/// Colossus mints one login per role; add app roles here AND to the contract, never demo users.
/// CLERK is the app-level non-privileged operator role (records movements, browses stock).
enum Role {
  USER
  CLERK
  MANAGER
  ADMIN
}

/// Platform-owned logins, materialized by prisma/seed/seed.js from COLOSSUS_ACCOUNTS_JSON.
/// Native to every Colossus app: the accounts Colossus shows are exactly the rows here,
/// and each one also exists as a User with the same bcrypt hash so it can log in.
model ColossusAccount {
  id           String   @id @default(uuid())
  role         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  loginPath    String   @map("login_path")
  createdBy    String   @default("colossus") @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("colossus_accounts")
}

/// Catalogue entry. `reorderAt` is the low-stock threshold compared against SUM(StockLevel.qty).
model Item {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  description String?
  unit        String
  reorderAt   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockLevels StockLevel[]
  movements   Movement[]

  @@index([name])
}

/// Physical storage location. `name` is the natural key the seed upserts on.
model Location {
  id        String   @id @default(uuid())
  name      String   @unique
  zone      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLevels   StockLevel[]
  movementsFrom Movement[]   @relation("MovementFromLocation")
  movementsTo   Movement[]   @relation("MovementToLocation")

  @@index([zone])
}

/// On-hand quantity of one item at one location. The conditional `updateMany`
/// guard in MovementsService relies on @@unique([itemId, locationId]) to make
/// over-draw rejection race-safe.
model StockLevel {
  id         String   @id @default(uuid())
  itemId     String
  locationId String
  qty        Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId])
  @@index([locationId])
}

/// Immutable audit record of a stock change. Never updated or deleted —
/// corrections are entered as compensating movements.
model Movement {
  id        String       @id @default(uuid())
  type      MovementType
  itemId    String
  fromLocId String?
  toLocId   String?
  qty       Int
  note      String?
  userId    String
  createdAt DateTime     @default(now())

  item    Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  fromLoc Location? @relation("MovementFromLocation", fields: [fromLocId], references: [id], onDelete: Restrict)
  toLoc   Location? @relation("MovementToLocation", fields: [toLocId], references: [id], onDelete: Restrict)
  user    User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([itemId, createdAt])
  @@index([createdAt])
  @@index([type])
  @@index([userId])
}

/// IN adds to toLoc; OUT removes from fromLoc; TRANSFER moves fromLoc -> toLoc.
enum MovementType {
  IN
  OUT
  TRANSFER
}

/// Runtime override layer for service credentials (postgresql / minio / llm).
/// `resolveConfig()` reads process.env first and falls back to this table.
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
