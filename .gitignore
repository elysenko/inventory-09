# Dependencies — regenerated by `npm ci` during the deploy build; never committed.
node_modules/

# Build output — regenerated by `npm run build` during the deploy build.
dist/
out-tsc/
/tmp/

# Local secrets — README tells you to `cp .env.example .env`; never commit the result.
.env
.env.*
!.env.example

# Angular build cache
.angular/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS noise
.DS_Store
*.swp
